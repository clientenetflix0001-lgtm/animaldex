{
  "expo": {
    "name": "Animaldex",
    "slug": "animaldex",
    "scheme": "animaldex",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lucasap123.animaldex",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Animaldex usa tu ubicación solo cuando decides compartirla con el dueño de una mascota, tocando el botón de compartir ubicación.",
        "NSCameraUsageDescription": "Animaldex usa la cámara para escanear códigos QR de mascotas y perfiles."
      }
    },
    "android": {
      "package": "com.lucasap123.animaldex",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFE8E1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "animaldex-web.pages.dev", "pathPrefix": "/p/" },
            { "scheme": "https", "host": "animaldex-web.pages.dev", "pathPrefix": "/pet/" },
            { "scheme": "https", "host": "animaldex-web.pages.dev", "pathPrefix": "/a/" },
            { "scheme": "https", "host": "animaldex-web.pages.dev", "pathPrefix": "/m/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "animaldex-web.pages.dev",
              "pathAdvancedPattern": "/[a-zA-Z0-9._]{3,20}"
            },
            {
              "scheme": "https",
              "host": "animaldex-web.pages.dev",
              "pathAdvancedPattern": "/[a-zA-Z0-9._]{3,20}/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "animaldex.com", "pathPrefix": "/p/" },
            { "scheme": "https", "host": "animaldex.com", "pathPrefix": "/pet/" },
            { "scheme": "https", "host": "animaldex.com", "pathPrefix": "/a/" },
            { "scheme": "https", "host": "animaldex.com", "pathPrefix": "/m/" },
            { "scheme": "https", "host": "www.animaldex.com", "pathPrefix": "/p/" },
            { "scheme": "https", "host": "www.animaldex.com", "pathPrefix": "/pet/" },
            { "scheme": "https", "host": "www.animaldex.com", "pathPrefix": "/a/" },
            { "scheme": "https", "host": "www.animaldex.com", "pathPrefix": "/m/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "animaldex.com",
              "pathAdvancedPattern": "/[a-zA-Z0-9._]{3,20}"
            },
            {
              "scheme": "https",
              "host": "animaldex.com",
              "pathAdvancedPattern": "/[a-zA-Z0-9._]{3,20}/"
            },
            {
              "scheme": "https",
              "host": "www.animaldex.com",
              "pathAdvancedPattern": "/[a-zA-Z0-9._]{3,20}"
            },
            {
              "scheme": "https",
              "host": "www.animaldex.com",
              "pathAdvancedPattern": "/[a-zA-Z0-9._]{3,20}/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/f2b4eacd-6e1a-4dbc-89cd-b65598756451"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "lucasap123",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Animaldex usa la cámara para escanear códigos QR de mascotas y perfiles."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF6B4A",
          "defaultChannel": "mascotas"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f2b4eacd-6e1a-4dbc-89cd-b65598756451"
      }
    }
  }
}
